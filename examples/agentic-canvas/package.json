    "detect": "../../.github/skills/impeccable/scripts/impeccable detect --json src"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.16",
    "zod": "4.6.5"
  }
}
