# Copy to .env locally. Never place these values in VITE_* variables.
# Live calls also require explicit browser consent. No hosted image adapter is enabled.
JEV_API_KEY=replace-with-your-local-jev-api-key
# Optional Copilot model; authentication uses local Copilot login or this server-only token.
COPILOT_MODEL=
COPILOT_GITHUB_TOKEN=
# Judgment thresholds are heuristics, not calibrated guarantees.
JEV_CHOICE_THRESHOLD=0.80
JEV_SCORE_THRESHOLD=0.80
JEV_CONFIDENCE_THRESHOLD=0.80
JEV_WORKFLOW_THRESHOLD=0.85
JEV_WORKFLOW_MARGIN=0.15
